{
	# No access log. Only error-level entries are logged, and on proxy errors they can still include the client address.
	log {
		output stderr
		level ERROR
	}
}

api.liberdadefamilia.com.br {
	header -Server
	reverse_proxy api-production:8080
}

api-staging.liberdadefamilia.com.br {
	header -Server
	reverse_proxy api-staging:8080
}
