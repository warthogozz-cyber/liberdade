{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "vite --mode mocks",
    "build": "tsc -b && vite build",
    "check:chunks": "node scripts/check-chunks.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/shared/api/schema.ts --properties-required-by-default",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "dexie": "4.4.7",
    "echarts": "6.1.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.2.0",
    "react-router": "^8.5.1",
    "uuid": "^14.0.3",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "3.0.7",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "wrangler": "4.164.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
