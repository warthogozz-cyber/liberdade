{
  "openapi": "3.0.1",
  "info": {
    "title": "Liberdade API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v1/csrf": {
      "get": {
        "operationId": "csrf",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenView"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "csrf-controller"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "me-controller"
        ]
      }
    },
    "/v1/workspaces": {
      "post": {
        "operationId": "createWorkspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceView"
                }
              }
            },
            "description": "Created"
          }
        },
        "tags": [
          "workspace-controller"
        ]
      }
    },
    "/v1/workspaces/{ws}/accounts": {
      "get": {
        "operationId": "listAccounts",
        "parameters": [
          {
            "in": "path",
            "name": "ws",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccountView"
                  }
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "account-controller"
        ]
      }
    },
    "/v1/workspaces/{ws}/categories": {
      "get": {
        "operationId": "listCategories",
        "parameters": [
          {
            "in": "path",
            "name": "ws",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "EXPENSE",
                "INCOME"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryView"
                  }
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "category-controller"
        ]
      }
    },
    "/v1/workspaces/{ws}/dashboard": {
      "get": {
        "operationId": "dashboard",
        "parameters": [
          {
            "in": "path",
            "name": "ws",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string",
              "example": "2026-11"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardView"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "dashboard-controller"
        ]
      }
    },
    "/v1/workspaces/{ws}/transactions": {
      "get": {
        "operationId": "listTransactions",
        "parameters": [
          {
            "in": "path",
            "name": "ws",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string",
              "example": "2026-11"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionView"
                  }
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "transaction-controller"
        ]
      },
      "post": {
        "operationId": "recordTransaction",
        "parameters": [
          {
            "in": "path",
            "name": "ws",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionView"
                }
              }
            },
            "description": "A resend: the stored transaction"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionView"
                }
              }
            },
            "description": "Recorded"
          }
        },
        "tags": [
          "transaction-controller"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountView": {
        "type": "object",
        "properties": {
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string",
            "example": "BRL"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "CHECKING",
              "SAVINGS",
              "CASH",
              "CREDIT_CARD",
              "WALLET",
              "INVESTMENT"
            ]
          }
        }
      },
      "CategoryView": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE",
              "TRANSFER"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateTransactionRequest": {
        "required": [
          "accountId",
          "amount",
          "categoryId",
          "id",
          "kind",
          "occurredOn"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "maxLength": 140,
            "minLength": 0,
            "pattern": "[^\\x00]*",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE",
              "TRANSFER"
            ]
          },
          "occurredOn": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CreateWorkspaceRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CsrfTokenView": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "DashboardView": {
        "type": "object",
        "properties": {
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "expenses": {
            "$ref": "#/components/schemas/Money"
          },
          "month": {
            "type": "string"
          }
        }
      },
      "MeUser": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "passkeyCreatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MeView": {
        "type": "object",
        "properties": {
          "suggestedWorkspaceName": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeWorkspace"
            }
          }
        }
      },
      "MeWorkspace": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADULT",
              "YOUTH",
              "VIEWER"
            ]
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "Money": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "pattern": "^-?\\d+(\\.\\d{1,4})?$",
            "type": "string",
            "example": "12.34"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string",
            "example": "BRL"
          }
        }
      },
      "TransactionView": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE",
              "TRANSFER"
            ]
          },
          "memberId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredOn": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "WorkspaceView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADULT",
              "YOUTH",
              "VIEWER"
            ]
          }
        }
      }
    }
  }
}
